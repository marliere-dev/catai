---
const estab = [
  { t: 'Cria conta com email', b: 'Zero burocracia. Email, senha, nome do lugar. Pronto.' },
  { t: 'Tira foto e descreve', b: 'Aponta a câmera pro material, escreve duas linhas. O endereço já vem do mapa.' },
  { t: 'Catador aceita e busca', b: 'Você recebe o nome de quem aceitou. Combina o horário no chat curto.' },
];
const catador = [
  { t: 'Cria conta com email', b: 'Mesmo cadastro simples. Sem documentação obrigatória.' },
  { t: 'Vê no mapa o que tem perto', b: 'Lista das solicitações próximas com foto, endereço e distância.' },
  { t: 'Aceita, coleta, conclui', b: 'Marca como concluída ao final. Histórico fica pra você consultar depois.' },
];
---
<section class="px-6 py-20">
  <div class="max-w-[1100px] mx-auto">
    <div class="grid md:grid-cols-[180px_1fr] gap-12 mb-12">
      <div class="text-xs uppercase tracking-[0.14em] text-ink-soft font-medium pt-3">§2 &nbsp; como funciona</div>
      <h2 class="font-serif text-[clamp(36px,5vw,56px)] font-normal tracking-tight text-ink m-0 leading-[1.05]">
        Dois lados.<br/>
        <span class="italic text-sage-deep">Um caminho curto entre eles.</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {[
        { kind: 'Estabelecimento', label: 'perfil A', sub: 'bar, mercado, restaurante, escritório, lojinha de bairro.', steps: estab },
        { kind: 'Catador', label: 'perfil B', sub: 'profissional que coleta, autônomo ou cooperativado.', steps: catador },
      ].map(col => (
        <div class="p-8 rounded-[28px] bg-soft relative overflow-hidden">
          <div class="text-[11px] uppercase tracking-[0.14em] text-ink-soft font-medium relative">{col.label}</div>
          <h3 class="font-serif text-4xl font-normal text-ink mt-2 mb-1.5 tracking-tight relative">{col.kind}</h3>
          <p class="text-[14.5px] text-ink-soft mb-9 relative max-w-[360px] leading-[1.5]">{col.sub}</p>
          <ol class="list-none p-0 m-0 flex flex-col gap-5">
            {col.steps.map((s, i) => (
              <li class="grid grid-cols-[40px_1fr] gap-4 pb-6 border-b border-ink/10">
                <div class="font-serif text-3xl text-sage-deep italic leading-none">{i + 1}</div>
                <div>
                  <div class="font-sans text-[17px] font-semibold text-ink mb-1 tracking-tight">{s.t}</div>
                  <div class="text-[14.5px] text-ink-soft leading-[1.55]" style="text-wrap: pretty;">{s.b}</div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
