---
const cards = [
  { kind: 'Catadores', title: 'Você que cata', body: 'Seu feedback é o que mais importa. Conta o que falta, o que confunde, o que precisa ser diferente. Mesmo sem mexer em código.', cta: 'Mandar um email', href: 'mailto:ola@catai.app?subject=Feedback%20de%20catador' },
  { kind: 'Designers', title: 'Você que desenha', body: 'Ilustração leve, fluxos do app, identidade visual, ícones, este aqui que você está lendo. Tem espaço pra muita coisa boa.', cta: 'Ver issues de design', href: '#' },
  { kind: 'Devs', title: 'Você que programa', body: 'Stack: TypeScript, NestJS no backend, React Native no app. Issues marcadas como "good first issue" pra começar tranquilo.', cta: 'Ver no GitHub', href: '#' },
];
const needs = ['ilustração de mascote','tela de onboarding','testes em campo','tradução de microcopy','fluxo de cadastro do catador','design do email de confirmação','feedback de cooperativas'];
---
<section id="ajudar" class="px-6 py-24 bg-soft">
  <div class="max-w-[1100px] mx-auto">
    <div class="grid md:grid-cols-[180px_1fr] gap-12 mb-14">
      <div class="text-xs uppercase tracking-[0.14em] text-ink-soft font-medium pt-3">§5 &nbsp; quero ajudar</div>
      <div>
        <h2 class="font-serif text-[clamp(36px,5vw,56px)] font-normal tracking-tight text-ink m-0 leading-[1.05] max-w-[720px]">
          Tem três jeitos.<br/><span class="italic text-sage-deep">Todos contam igual.</span>
        </h2>
        <p class="text-[17px] leading-[1.6] text-ink-soft mt-6 max-w-[600px]">
          A gente quer construir isso com calma e com gente que vai usar.
          Quem cata, quem mexe em código, quem desenha. Chega junto.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-4">
      {cards.map(card => (
        <a href={card.href} class="p-7 bg-paper rounded-3xl no-underline flex flex-col gap-3.5 min-h-[280px] border border-ink/10 hover:-translate-y-0.5 hover:shadow-lg transition">
          <div class="text-[11px] uppercase tracking-[0.14em] text-sage-deep font-semibold">{card.kind}</div>
          <div class="font-serif text-[28px] text-ink tracking-tight leading-tight">{card.title}</div>
          <p class="text-[14.5px] text-ink-soft leading-[1.55] m-0 flex-1" style="text-wrap: pretty;">{card.body}</p>
          <div class="mt-auto flex items-center gap-2 text-sm text-ink font-medium">{card.cta} →</div>
        </a>
      ))}
    </div>

    <div class="mt-14 pt-8 border-t border-ink/20">
      <div class="text-xs uppercase tracking-[0.14em] text-ink-soft font-medium mb-5">agora mesmo a gente precisa de</div>
      <div class="flex flex-wrap gap-2">
        {needs.map(n => (
          <span class="px-3.5 py-1.5 rounded-full bg-paper text-[13px] text-ink border border-ink/10">{n}</span>
        ))}
      </div>
    </div>
  </div>
</section>
