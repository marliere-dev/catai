# Test environment for e2e suite — copy to .env.test
NODE_ENV=test
PORT=0
DATABASE_URL=postgres://catai:catai@localhost:5432/catai_test
RESERVE_TTL_HOURS=2

# Firebase env vars are intentionally empty — tests use FakeFirebaseTokenValidator.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# R2 vars intentionally empty — StorageService runs in in-memory mode under tests.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
