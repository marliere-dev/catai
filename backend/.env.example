# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://catai:catai@localhost:5432/catai

# Firebase (Admin SDK service account)
# Get a JSON key from Firebase Console -> Project settings -> Service accounts.
# In dev you can leave these empty and the backend will use FakeFirebaseTokenValidator.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Image storage. Three modes (priority order):
#   1) R2_BUCKET + R2_* set: Cloudflare R2 (production-ready, CDN, durabilidade)
#   2) STORAGE_LOCAL_DIR set: disco local do servidor; servido via /storage/local
#   3) ambos vazios: memória do processo (apenas dev; sem persistência)

# Disk mode
STORAGE_LOCAL_DIR=
STORAGE_LOCAL_BASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Business rules
RESERVE_TTL_HOURS=2
