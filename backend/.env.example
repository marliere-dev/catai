# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://catai:catai@localhost:5432/catai

# Firebase (Admin SDK service account)
# Get a JSON key from Firebase Console -> Project settings -> Service accounts.
# In dev you can leave these empty and the backend will use FakeFirebaseTokenValidator.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 (image storage)
# Leave R2_BUCKET empty to run StorageService in in-memory mode (dev/tests).
# In in-memory mode, no objects are persisted; uploads return fake URLs.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Business rules
RESERVE_TTL_HOURS=2
