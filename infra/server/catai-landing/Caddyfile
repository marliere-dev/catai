:80 {
	# Form submissions go to the Go collector.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy collector:8081
	}

	handle {
		root * /var/www/releases/{$SITE_TAG}
		# Serve URLs without .html suffix (/feedback → /feedback.html).
		try_files {path} {path}.html
		file_server
		encode gzip

		# Assets versionados (CSS/JS com hash) podem cachear forte
		@assets path /_astro/* /assets/*
		header @assets Cache-Control "public, max-age=604800, immutable"

		# HTML não cacheia (permite iterar sem invalidar)
		@html path /index.html /feedback.html /
		header @html Cache-Control "no-cache, must-revalidate"
	}

	log {
		output stdout
		format console
	}
}
