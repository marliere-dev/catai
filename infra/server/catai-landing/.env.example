# Telegram bot that receives form submissions from /feedback.
# Reuse the same bot+chat from pursuit-landing if you want a single inbox.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional rate limiter on the collector. Default is 10 submissions/hour/IP.
RATE_LIMIT_PER_IP_PER_HOUR=10

# `COLLECTOR_TAG` e `SITE_TAG` ficam em `.release.env`, gerenciado pelo
# oracle-deployctl.
