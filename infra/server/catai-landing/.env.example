# Tunnel token from Cloudflare Zero Trust dashboard:
# Networks → Tunnels → Create a tunnel → copy the token (the long eyJh... string)
TUNNEL_TOKEN=

# Telegram bot that receives form submissions from /feedback.
# Reuse the same bot+chat from pursuit-landing if you want a single inbox.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional rate limiter on the collector. Default is 10 submissions/hour/IP.
RATE_LIMIT_PER_IP_PER_HOUR=10

# Collector image tag. Bump together with frontend/scripts/build-collector.sh.
COLLECTOR_TAG=v0.1.0
