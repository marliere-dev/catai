# Backend public URL the app talks to (NestJS API).
# Pick the option that fits how you'll test:
#   iOS Simulator on the dev machine: http://localhost:3000
#   Physical device on the same WiFi: http://192.168.X.Y:3000
#   Tunnel'd publicly:                https://api.catai.marliere.dev
EXPO_PUBLIC_API_URL=http://localhost:3000

# Firebase web SDK config (Firebase Console -> Project settings -> SDK setup)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
